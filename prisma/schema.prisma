generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PostType {
  PHOTO
  TEXT
  PHOTO_TEXT
  CHECKIN
}

enum CafePhotoKind {
  GALLERY
  MENU
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  LOCATION
  VOICE
  VIDEO
  STICKER
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_LIKE
  NEW_MESSAGE
  GIFT_COFFEE
  FRIEND_CHECKIN
  FRIEND_JOINED_EVENT
  EVENT_STARTING_SOON
  SQUAD_INVITATION
  SQUAD_MESSAGE
  STREAK_MILESTONE
}

enum GiftStatus {
  PENDING_PAYMENT
  PAID
  ASSIGNED
  REDEEMED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  POST
  REVIEW
  CAFE
  MESSAGE
}

enum BadgeCode {
  FIRST_CHECKIN
  FIVE_CAFES
  TEN_CAFES
  TWENTY_CAFES
  WEEKLY_EXPLORER
}

enum RewardType {
  FREE_DRINK
  DISCOUNT_10
  DISCOUNT_20
  PARTNER_PERK
}

enum CheckinSource {
  APP
  QR
}

enum BeanScoreAction {
  CHECKIN
  NEW_STAMP
  POST
  POST_PHOTO
  REVIEW
  LIKE_RECEIVED
  DAILY_ACTIVE
  REFERRAL
  CHALLENGE_COMPLETE
}

enum ChallengeType {
  CHECKIN_COUNT
  NEW_STAMPS
  VISIT_UNIQUE_CAFES
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}

enum ReactionEmoji {
  LIKE
  HEART
  FIRE
  CLAP
  LAUGH
  WOW
  SAD
}

enum ActivityType {
  FRIEND_CHECKIN
  FRIEND_JOINED_EVENT
  FRIEND_EARNED_BADGE
  FRIEND_COMPLETED_CHALLENGE
  FRIEND_JOINED_SQUAD
  FRIEND_STREAK_MILESTONE
  FRIEND_COLLECTED_CARD
  CAFE_TRENDING
  EVENT_ANNOUNCED
  SQUAD_ACTIVITY
}

enum EventType {
  OPEN_MIC
  GAME_NIGHT
  STUDY_GROUP
  STARTUP_MEETUP
  MUSIC_NIGHT
  COFFEE_WORKSHOP
  BOOK_CLUB
  OTHER
}

enum SquadCategory {
  GAMERS
  COFFEE_LOVERS
  ARTISTS
  STUDENTS
  DEVELOPERS
  BOOK_CLUB
  OTHER
}

enum SquadRole {
  MEMBER
  ADMIN
  OWNER
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum StreakType {
  DAILY_VISIT
  WEEKLY_CAFE
  CONSECUTIVE_CHECKIN
  EVENT_PARTICIPATION
}

model Country {
  id     String @id @default(uuid())
  code   String @unique
  name   String
  cities City[]
  users  User[]
  cafes  Cafe[]
  posts  Post[]
  reviews Review[]
  checkins Checkin[]
  gifts  GiftCoffee[]
  squads Squad[]
}

model City {
  id        String   @id @default(uuid())
  countryId String
  name      String
  slug      String
  country   Country  @relation(fields: [countryId], references: [id])
  users     User[]
  cafes     Cafe[]
  posts     Post[]
  reviews   Review[]
  checkins  Checkin[]
  gifts     GiftCoffee[]
  favoriteCafes FavoriteCafe[]
  challenges CommunityChallenge[]
  events     CommunityEvent[]
  squads     Squad[]
  activities FriendActivity[]

  @@unique([countryId, slug])
}

model User {
  id              String    @id @default(uuid())
  phone           String?   @unique
  email           String?   @unique
  googleId        String?   @unique
  username        String?   @unique
  name            String?
  bio             String?
  avatarUrl       String?
  cityId          String?
  countryId       String?
  role            UserRole  @default(USER)
  referralCode    String?   @unique
  referredById    String?
  postsCount      Int       @default(0)
  followersCount  Int       @default(0)
  followingCount  Int       @default(0)
  refreshTokenHash String?
  lastSeenAt      DateTime?
  showLastSeen    Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  refreshTokens   RefreshToken[]
  city            City?     @relation(fields: [cityId], references: [id])
  country         Country?  @relation(fields: [countryId], references: [id])
  devices         Device[]
  posts           Post[]
  comments        Comment[]
  likes           Like[]
  savedPosts      SavedPost[]
  reviews         Review[]
  checkins        Checkin[]
  followers       UserFollow[] @relation("following")
  following       UserFollow[] @relation("follower")
  cafeFollows     CafeFollow[]
  favoriteCafes   FavoriteCafe[]
  conversationMembers ConversationMember[]
  messagesSent    Message[]
  notifications   Notification[]
  notificationsActed Notification[] @relation("NotificationActor")
  reports         Report[]
  giftsSent       GiftCoffee[] @relation("GiftSender")
  giftsReceived   GiftCoffee[] @relation("GiftReceiver")
  voucherRedemptions VoucherRedemption[]
  passport           Passport?
  userBadges         UserBadge[]
  userRewards        UserReward[]
  beanScore          BeanScoreProfile?
  beanScoreEvents    BeanScoreEvent[]
  postReactions      PostReaction[]
  workReports        WorkReport[]
  messageReactions   MessageReaction[]
  messageHides       MessageHide[]
  cafeOwnerships     CafeOwner[]
  challengeEntries   ChallengeParticipation[]
  eventRsvps         EventRsvp[]
  referralsMade      Referral[] @relation("Referrer")
  referralAsReferred Referral?
  referredBy         User?      @relation("UserReferrals", fields: [referredById], references: [id])
  usersReferred      User[]     @relation("UserReferrals")
  friendActivities   FriendActivity[]
  squadMemberships   SquadMember[]
  squadMessages      SquadMessage[]
  usersBlocked       UserBlock[] @relation("UserBlocked")
  blockedBy          UserBlock[] @relation("UserBlocker")
  squadsCreated      Squad[]    @relation("SquadCreator")
  collectibles       UserCollectible[]
  streaks            UserStreak[]
  eventReminders     EventReminder[]
  eventsHosted       CommunityEvent[] @relation("EventHost")
  settings           UserSettings?
}

enum VisibilityLevel {
  EVERYONE
  CONTACTS
  NOBODY
}

enum AutoDownloadMode {
  WIFI
  ALWAYS
  NEVER
}

enum MediaQualityLevel {
  STANDARD
  HIGH
}

enum FontSizeLevel {
  SMALL
  MEDIUM
  LARGE
}

enum MessageDensityLevel {
  COMPACT
  COMFORTABLE
  SPACIOUS
}

model UserSettings {
  userId                   String              @id
  lastSeenVisibility       VisibilityLevel     @default(EVERYONE)
  onlineStatusVisibility   VisibilityLevel     @default(EVERYONE)
  readReceipts             Boolean             @default(true)
  profileVisibility        VisibilityLevel     @default(EVERYONE)
  pushNotifications        Boolean             @default(true)
  messageNotifications     Boolean             @default(true)
  mentionNotifications     Boolean             @default(true)
  groupNotifications       Boolean             @default(true)
  marketingNotifications   Boolean             @default(false)
  emailNotifications       Boolean             @default(true)
  notificationSound        Boolean             @default(true)
  notificationVibration    Boolean             @default(true)
  accentColor              String              @default("oklch(0.55 0.2 145)")
  fontSize                 FontSizeLevel       @default(MEDIUM)
  messageDensity           MessageDensityLevel @default(COMFORTABLE)
  chatWallpaper            String              @default("default")
  autoDownloadMedia        AutoDownloadMode    @default(WIFI)
  mediaQuality             MediaQualityLevel   @default(HIGH)
  saveDrafts               Boolean             @default(true)
  linkPreviews             Boolean             @default(true)
  typingIndicators         Boolean             @default(true)
  autoCleanupDays          Int                 @default(30)
  updatedAt                DateTime            @updatedAt
  user                     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id              String   @id @default(uuid())
  referrerId      String
  referredUserId  String   @unique
  pointsAwarded   Int      @default(50)
  createdAt       DateTime @default(now())
  referrer        User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred        User     @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  pushToken  String?
  platform   String
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Cafe {
  id             String   @id @default(uuid())
  name           String
  address        String
  lat            Float
  lng            Float
  cityId         String
  countryId      String
  avgRating      Float    @default(0)
  followerCount  Int      @default(0)
  reviewCount    Int      @default(0)
  isPartner      Boolean  @default(false)
  checkinCode    String?  @unique
  claimCode      String?  @unique
  bestCoffee     Boolean  @default(false)
  bestWorkspace  Boolean  @default(false)
  quiet          Boolean  @default(false)
  studyFriendly  Boolean  @default(false)
  fastWifi       Boolean  @default(false)
  outdoorSeating Boolean  @default(false)
  dateFriendly   Boolean  @default(false)
  petFriendly    Boolean  @default(false)
  workspaceScore Int      @default(0)
  liveWifiScore      Float?
  liveNoiseLevel     Float?
  liveOutletScore    Float?
  workReportCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  city           City     @relation(fields: [cityId], references: [id])
  country        Country  @relation(fields: [countryId], references: [id])
  photos         CafePhoto[]
  posts          Post[]
  reviews        Review[]
  checkins       Checkin[]
  followers      CafeFollow[]
  favorites      FavoriteCafe[]
  voucherRedemptions VoucherRedemption[]
  stamps             Stamp[]
  workReports        WorkReport[]
  owners             CafeOwner[]
  events             CommunityEvent[]
  squads             Squad[]
  collectibleCard    CollectibleCard?
  activities         FriendActivity[]

  @@index([cityId])
  @@index([cityId, avgRating])
  @@index([createdAt])
  @@index([followerCount])
}

model CafePhoto {
  id     String        @id @default(uuid())
  cafeId String
  url    String
  kind   CafePhotoKind @default(GALLERY)
  order  Int           @default(0)
  cafe   Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model CafeFollow {
  id         String   @id @default(uuid())
  userId     String
  cafeId     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([userId, cafeId])
}

model FavoriteCafe {
  id     String @id @default(uuid())
  userId String
  cafeId String
  cityId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe   Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id])

  @@unique([userId, cafeId])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  cafeId    String?
  checkinId String?  @unique
  type      PostType
  caption   String?
  cityId    String
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cafe      Cafe?    @relation(fields: [cafeId], references: [id])
  checkin   Checkin? @relation(fields: [checkinId], references: [id])
  city      City     @relation(fields: [cityId], references: [id])
  country   Country  @relation(fields: [countryId], references: [id])
  photos    PostPhoto[]
  comments  Comment[]
  likes     Like[]
  reactions PostReaction[]
  savedBy   SavedPost[]

  @@index([authorId, createdAt])
  @@index([cafeId, createdAt])
  @@index([createdAt])
}

model PostPhoto {
  id     String @id @default(uuid())
  postId String
  url    String
  order  Int    @default(0)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String?
  reviewId  String?
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Like {
  id       String  @id @default(uuid())
  userId   String
  postId   String?
  reviewId String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, reviewId])
}

model SavedPost {
  id     String @id @default(uuid())
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Review {
  id        String   @id @default(uuid())
  cafeId    String
  authorId  String
  rating    Int
  body      String?
  cityId    String
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id])
  country   Country  @relation(fields: [countryId], references: [id])
  photos    ReviewPhoto[]
  comments  Comment[]
  likes     Like[]

  @@index([cafeId, createdAt])
}

model ReviewPhoto {
  id       String @id @default(uuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Checkin {
  id        String        @id @default(uuid())
  userId    String
  cafeId    String
  cityId    String
  countryId String
  source    CheckinSource @default(APP)
  mood      String?
  status    String?
  withUserIds String[]    @default([])
  createdAt DateTime      @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  city      City     @relation(fields: [cityId], references: [id])
  country   Country  @relation(fields: [countryId], references: [id])
  post      Post?
  stamp     Stamp?

  @@index([userId, createdAt])
  @@index([cafeId, createdAt])
  @@index([userId, cafeId, createdAt])
}

model Passport {
  id             String   @id @default(uuid())
  userId         String   @unique
  totalStamps    Int      @default(0)
  totalCheckins  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamps         Stamp[]
}

model Stamp {
  id         String   @id @default(uuid())
  passportId String
  cafeId     String
  checkinId  String?  @unique
  earnedAt   DateTime @default(now())
  passport   Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  checkin    Checkin? @relation(fields: [checkinId], references: [id], onDelete: SetNull)
  @@unique([passportId, cafeId])
  @@index([passportId, earnedAt])
}

model BadgeDefinition {
  code          BadgeCode @id
  name          String
  description   String
  iconKey       String
  threshold     Int
  thresholdType String
  userBadges    UserBadge[]
}

model UserBadge {
  id        String    @id @default(uuid())
  userId    String
  badgeCode BadgeCode
  earnedAt  DateTime  @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     BadgeDefinition @relation(fields: [badgeCode], references: [code])
  @@unique([userId, badgeCode])
  @@index([userId, earnedAt])
}

model RewardDefinition {
  id             String     @id @default(uuid())
  slug           String     @unique
  title          String
  description    String
  requiredStamps Int
  rewardType     RewardType
  active         Boolean    @default(true)
  userRewards    UserReward[]
}

model UserReward {
  id         String    @id @default(uuid())
  userId     String
  rewardId   String
  unlockedAt DateTime  @default(now())
  redeemedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     RewardDefinition @relation(fields: [rewardId], references: [id])
  @@unique([userId, rewardId])
  @@index([userId, unlockedAt])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id                String       @id @default(uuid())
  conversationId    String
  userId            String
  lastReadAt        DateTime?
  lastReadMessageId String?
  muted             Boolean      @default(false)
  pinned            Boolean      @default(false)
  deletedAt         DateTime?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  body           String?
  imageUrl       String?
  attachmentUrl  String?
  attachmentName String?
  attachmentMimeType String?
  attachmentSize Int?
  attachmentDurationSec Int?
  locationLat    Float?
  locationLng    Float?
  locationLabel  String?
  sticker        String?
  replyToId      String?
  replyToSnippet String?
  forwardedFromId   String?
  forwardedFromName String?
  editedAt       DateTime?
  deletedAt      DateTime?
  isPinned       Boolean     @default(false)
  seenBy         String[]    @default([])
  createdAt      DateTime    @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions      MessageReaction[]
  hides          MessageHide[]

  @@index([conversationId, createdAt])
}

model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  hiddenAt  DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model BeanScoreProfile {
  userId           String    @id
  totalPoints      Int       @default(0)
  level            Int       @default(1)
  lastDailyBonusAt DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([totalPoints])
}

model BeanScoreEvent {
  id          String          @id @default(uuid())
  userId      String
  action      BeanScoreAction
  points      Int
  referenceId String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, action, referenceId])
  @@index([userId, createdAt])
}

model PostReaction {
  id        String        @id @default(uuid())
  userId    String
  postId    String
  emoji     ReactionEmoji @default(LIKE)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId])
  @@index([postId])
}

model MessageReaction {
  id        String        @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model WorkReport {
  id          String   @id @default(uuid())
  userId      String
  cafeId      String
  wifiScore   Int
  noiseLevel  Int
  outletScore Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  @@index([cafeId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  actorId    String?
  entityType String?
  entityId   String?
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GiftCoffee {
  id          String     @id @default(uuid())
  senderId    String
  receiverId  String?
  amount      Int
  cityId      String
  countryId   String
  status      GiftStatus @default(PENDING_PAYMENT)
  paymentRef  String?
  voucherCode String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sender      User       @relation("GiftSender", fields: [senderId], references: [id])
  receiver    User?      @relation("GiftReceiver", fields: [receiverId], references: [id])
  city        City       @relation(fields: [cityId], references: [id])
  country     Country    @relation(fields: [countryId], references: [id])
  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id               String   @id @default(uuid())
  giftId           String
  cafeId           String
  redeemedByUserId String?
  redeemedAt       DateTime @default(now())
  gift             GiftCoffee @relation(fields: [giftId], references: [id])
  cafe             Cafe     @relation(fields: [cafeId], references: [id])
  redeemedBy       User?    @relation(fields: [redeemedByUserId], references: [id])
}

model CafeOwner {
  userId    String
  cafeId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@id([userId, cafeId])
  @@index([cafeId])
}

model CommunityChallenge {
  id           String        @id @default(uuid())
  title        String
  description  String
  type         ChallengeType
  goal         Int
  rewardPoints Int           @default(100)
  cityId       String?
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  city         City?         @relation(fields: [cityId], references: [id])
  participants ChallengeParticipation[]

  @@index([active, endsAt])
  @@index([cityId, startsAt])
}

model ChallengeParticipation {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId, progress])
}

model CommunityEvent {
  id            String    @id @default(uuid())
  title         String
  description   String
  type          EventType @default(OTHER)
  cafeId        String?
  cityId        String?
  hostId        String?
  capacity      Int?
  locationLabel String?
  coverUrl      String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime  @default(now())
  cafe          Cafe?     @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  city          City?     @relation(fields: [cityId], references: [id])
  host          User?     @relation("EventHost", fields: [hostId], references: [id], onDelete: SetNull)
  rsvps         EventRsvp[]
  reminders     EventReminder[]
  activities    FriendActivity[]

  @@index([startsAt])
  @@index([cityId, startsAt])
  @@index([type, startsAt])
}

model EventRsvp {
  id        String          @id @default(uuid())
  userId    String
  eventId   String
  status    EventRsvpStatus @default(GOING)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CommunityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  reporter   User             @relation(fields: [reporterId], references: [id])

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

model FriendActivity {
  id         String       @id @default(uuid())
  actorId    String
  type       ActivityType
  cafeId     String?
  eventId    String?
  squadId    String?
  badgeCode  BadgeCode?
  checkinId  String?
  cityId     String?
  cheerCount Int          @default(0)
  payload    Json?
  createdAt  DateTime     @default(now())

  actor User            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  cafe  Cafe?           @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  event CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  squad Squad?          @relation(fields: [squadId], references: [id], onDelete: SetNull)
  city  City?           @relation(fields: [cityId], references: [id])

  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([cityId, createdAt])
  @@index([createdAt])
}

model Squad {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  category    SquadCategory @default(OTHER)
  cafeId      String?
  cityId      String?
  countryId   String?
  coverUrl    String?
  emoji       String?
  isPublic    Boolean       @default(true)
  memberCount Int           @default(0)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cafe       Cafe?    @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  city       City?    @relation(fields: [cityId], references: [id])
  country    Country? @relation(fields: [countryId], references: [id])
  createdBy  User?    @relation("SquadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    SquadMember[]
  messages   SquadMessage[]
  activities FriendActivity[]

  @@index([cafeId])
  @@index([cityId, memberCount])
  @@index([category])
}

model SquadMember {
  id         String    @id @default(uuid())
  squadId    String
  userId     String
  role       SquadRole @default(MEMBER)
  points     Int       @default(0)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  squad      Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
  @@index([squadId, points])
}

model SquadMessage {
  id        String   @id @default(uuid())
  squadId   String
  senderId  String
  body      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([squadId, createdAt])
}

model CollectibleCard {
  id          String     @id @default(uuid())
  cafeId      String     @unique
  name        String
  artworkUrl  String?
  rarity      CardRarity @default(COMMON)
  description String?
  createdAt   DateTime   @default(now())
  cafe        Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  collectedBy UserCollectible[]

  @@index([rarity])
}

model UserCollectible {
  id          String   @id @default(uuid())
  userId      String
  cardId      String
  checkinId   String?
  collectedAt DateTime @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        CollectibleCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, collectedAt])
}

model UserStreak {
  id          String     @id @default(uuid())
  userId      String
  type        StreakType
  current     Int        @default(0)
  best        Int        @default(0)
  lastEventOn DateTime?
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model EventReminder {
  id        String    @id @default(uuid())
  userId    String
  eventId   String
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([remindAt, sentAt])
}

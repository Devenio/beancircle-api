generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CafeRole {
  OWNER
  MANAGER
  STAFF
  MODERATOR
}

enum CafeStaffInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MenuTheme {
  MINIMAL
  MODERN
  LUXURY
  DARK
  VINTAGE
  NEON
  CUSTOM
}

enum QrCodeKind {
  MENU
  TABLE
  ENTRANCE
  EVENT
}

enum LoyaltyProgramKind {
  STAMP_CARD
  VISIT_COUNT
  BIRTHDAY
  VIP
}

enum AnnouncementKind {
  ANNOUNCEMENT
  PROMOTION
  DISCOUNT
}

enum PostType {
  PHOTO
  TEXT
  PHOTO_TEXT
  CHECKIN
}

enum CafePhotoKind {
  GALLERY
  MENU
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  LOCATION
  VOICE
  VIDEO
  STICKER
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_COMMENT
  NEW_LIKE
  NEW_MESSAGE
  GIFT_COFFEE
  FRIEND_CHECKIN
  FRIEND_JOINED_EVENT
  EVENT_STARTING_SOON
  SQUAD_INVITATION
  SQUAD_MESSAGE
  STREAK_MILESTONE
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  CAFE_DAILY_WIN
  CAFE_ANNOUNCEMENT
  CAFE_STAFF_INVITE
  LOYALTY_REWARD
  BEAN_REPLY
  BEAN_REACTION
  BEAN_MENTION
  BEAN_REBEAN
  BEAN_QUOTE
  CHALLENGE_COMPLETE
}

enum GiftStatus {
  PENDING_PAYMENT
  PAID
  ASSIGNED
  REDEEMED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  POST
  REVIEW
  CAFE
  MESSAGE
}

enum BugCategory {
  BUG
  PERFORMANCE
  UI_UX
  CHAT
  NOTIFICATIONS
  PAYMENTS
  ACCOUNT
  FEATURE_REQUEST
  OTHER
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  INVESTIGATING
  FIXED
  CLOSED
}

enum BugAttachmentKind {
  SCREENSHOT
  ANNOTATION
  REPLAY
  LOG
  VIDEO
  OTHER
}

enum BadgeCode {
  FIRST_CHECKIN
  FIVE_CAFES
  TEN_CAFES
  TWENTY_CAFES
  WEEKLY_EXPLORER
  FIRST_FRIEND
  EXPLORER
  SOCIAL_BUTTERFLY
  NETWORK_BUILDER
  FIRST_SIP
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum LocationVisibility {
  EXACT
  APPROXIMATE
  CITY
  HIDDEN
}

enum DiscoveryVisibility {
  EVERYONE
  FRIENDS_OF_FRIENDS
  HIDDEN
}

enum InterestSlug {
  COFFEE
  BUSINESS
  STARTUPS
  AI
  FITNESS
  MUSIC
  GAMING
  TECH
  PROGRAMMING
  DESIGN
  BOOKS
  CRYPTO
  TRADING
  PHOTOGRAPHY
  TRAVEL
}

enum RewardType {
  FREE_DRINK
  DISCOUNT_10
  DISCOUNT_20
  PARTNER_PERK
}

enum CheckinSource {
  APP
  QR
}

enum BeanScoreAction {
  CHECKIN
  NEW_STAMP
  POST
  POST_PHOTO
  REVIEW
  LIKE_RECEIVED
  DAILY_ACTIVE
  REFERRAL
  CHALLENGE_COMPLETE
  BEAN
  BEAN_MEDIA
  BEAN_REPLY
  BEAN_REACTION_RECEIVED
  BEAN_REBEAN_RECEIVED
  BEAN_POPULAR
}

enum ChallengeType {
  CHECKIN_COUNT
  NEW_STAMPS
  VISIT_UNIQUE_CAFES
}

enum EventRsvpStatus {
  GOING
  INTERESTED
}

enum ReactionEmoji {
  LIKE
  HEART
  FIRE
  CLAP
  LAUGH
  WOW
  SAD
}

enum ActivityType {
  FRIEND_CHECKIN
  FRIEND_JOINED_EVENT
  FRIEND_EARNED_BADGE
  FRIEND_COMPLETED_CHALLENGE
  FRIEND_JOINED_SQUAD
  FRIEND_STREAK_MILESTONE
  FRIEND_COLLECTED_CARD
  CAFE_TRENDING
  EVENT_ANNOUNCED
  SQUAD_ACTIVITY
}

enum EventType {
  OPEN_MIC
  GAME_NIGHT
  STUDY_GROUP
  STARTUP_MEETUP
  MUSIC_NIGHT
  COFFEE_WORKSHOP
  BOOK_CLUB
  OTHER
}

enum SquadCategory {
  GAMERS
  COFFEE_LOVERS
  ARTISTS
  STUDENTS
  DEVELOPERS
  BOOK_CLUB
  OTHER
}

enum SquadRole {
  MEMBER
  ADMIN
  OWNER
}

enum CardRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum StreakType {
  DAILY_VISIT
  WEEKLY_CAFE
  CONSECUTIVE_CHECKIN
  EVENT_PARTICIPATION
}

model Country {
  id       String       @id @default(uuid())
  code     String       @unique
  name     String
  cities   City[]
  users    User[]
  cafes    Cafe[]
  posts    Post[]
  beans    Bean[]
  reviews  Review[]
  checkins Checkin[]
  gifts    GiftCoffee[]
  squads   Squad[]
}

model City {
  id            String               @id @default(uuid())
  countryId     String
  name          String
  slug          String
  country       Country              @relation(fields: [countryId], references: [id])
  users         User[]
  cafes         Cafe[]
  posts         Post[]
  beans         Bean[]
  reviews       Review[]
  checkins      Checkin[]
  gifts         GiftCoffee[]
  favoriteCafes FavoriteCafe[]
  challenges    CommunityChallenge[]
  events        CommunityEvent[]
  squads        Squad[]
  activities    FriendActivity[]
  userLocations UserLocation[]

  @@unique([countryId, slug])
}

model User {
  id               String     @id @default(uuid())
  phone            String?    @unique
  email            String?    @unique
  googleId         String?    @unique
  username         String?    @unique
  name             String?
  bio              String?
  avatarUrl        String?
  favoriteCoffee   String?
  website          String?
  socialLinks      Json?
  cityId           String?
  countryId        String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  bannedAt         DateTime?
  suspendedUntil   DateTime?
  moderationNote   String?
  referralCode     String?    @unique
  referredById     String?
  postsCount       Int        @default(0)
  followersCount   Int        @default(0)
  followingCount   Int        @default(0)
  refreshTokenHash String?
  lastSeenAt       DateTime?
  showLastSeen     Boolean    @default(true)
  dateOfBirth      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  refreshTokens          RefreshToken[]
  city                   City?                    @relation(fields: [cityId], references: [id])
  country                Country?                 @relation(fields: [countryId], references: [id])
  devices                Device[]
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  savedPosts             SavedPost[]
  reviews                Review[]
  checkins               Checkin[]
  followers              UserFollow[]             @relation("following")
  following              UserFollow[]             @relation("follower")
  cafeFollows            CafeFollow[]
  favoriteCafes          FavoriteCafe[]
  conversationMembers    ConversationMember[]
  messagesSent           Message[]
  notifications          Notification[]
  notificationsActed     Notification[]           @relation("NotificationActor")
  reports                Report[]
  bugReports             BugReport[]              @relation("BugReporter")
  bugAssignments         BugReport[]              @relation("BugAssignee")
  bugComments            BugReportComment[]       @relation("BugCommentAuthor")
  giftsSent              GiftCoffee[]             @relation("GiftSender")
  giftsReceived          GiftCoffee[]             @relation("GiftReceiver")
  voucherRedemptions     VoucherRedemption[]
  passport               Passport?
  userBadges             UserBadge[]
  userRewards            UserReward[]
  beanScore              BeanScoreProfile?
  beanScoreEvents        BeanScoreEvent[]
  postReactions          PostReaction[]
  workReports            WorkReport[]
  messageReactions       MessageReaction[]
  messageHides           MessageHide[]
  cafeStaff              CafeStaff[]
  cafesCreated           Cafe[]                   @relation("CafeCreator")
  staffInvitesSent       CafeStaffInvite[]        @relation("StaffInviteInviter")
  staffInvitesReceived   CafeStaffInvite[]        @relation("StaffInviteInvitee")
  auditLogs              AuditLog[]
  cafeCustomerOf         CafeCustomer[]
  loyaltyProgress        LoyaltyCardProgress[]
  qrScans                QrScan[]
  announcementsCreated   Announcement[]
  challengeEntries       ChallengeParticipation[]
  eventRsvps             EventRsvp[]
  referralsMade          Referral[]               @relation("Referrer")
  referralAsReferred     Referral?
  referredBy             User?                    @relation("UserReferrals", fields: [referredById], references: [id])
  usersReferred          User[]                   @relation("UserReferrals")
  friendActivities       FriendActivity[]
  squadMemberships       SquadMember[]
  squadMessages          SquadMessage[]
  usersBlocked           UserBlock[]              @relation("UserBlocked")
  blockedBy              UserBlock[]              @relation("UserBlocker")
  squadsCreated          Squad[]                  @relation("SquadCreator")
  collectibles           UserCollectible[]
  streaks                UserStreak[]
  eventReminders         EventReminder[]
  eventsHosted           CommunityEvent[]         @relation("EventHost")
  settings               UserSettings?
  location               UserLocation?
  interests              UserInterest[]
  sentFriendRequests     FriendRequest[]          @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]          @relation("ReceivedFriendRequests")
  friendshipsAsA         Friendship[]             @relation("FriendshipA")
  friendshipsAsB         Friendship[]             @relation("FriendshipB")
  suggestedFor           SuggestedConnection[]    @relation("SuggestedForUser")
  suggestedConnections   SuggestedConnection[]    @relation("SuggestedTarget")
  dailyDrawWins          CafeDailyDrawWinner[]
  connectionStreak       ConnectionStreak?
  dailyDiscoveries       DailyDiscovery[]         @relation("DailyDiscoverer")
  beans                  Bean[]
  beanReactions          BeanReaction[]
  beanPollVotes          BeanPollVote[]
  beanMentions           BeanMention[]
  discoveredInDaily      DailyDiscovery[]         @relation("DailyDiscovered")
  pushSubscriptions      PushSubscription[]
  adminAuditLogs         AdminAuditLog[]
  onboarding             OnboardingProgress?
  beanAvatar             BeanAvatar?
  onboardingEvents       OnboardingEvent[]
}

/// A browser Web Push subscription (one row per device/endpoint).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum VisibilityLevel {
  EVERYONE
  CONTACTS
  NOBODY
}

enum AutoDownloadMode {
  WIFI
  ALWAYS
  NEVER
}

enum MediaQualityLevel {
  STANDARD
  HIGH
}

enum FontSizeLevel {
  SMALL
  MEDIUM
  LARGE
}

enum MessageDensityLevel {
  COMPACT
  COMFORTABLE
  SPACIOUS
}

model UserSettings {
  userId                 String              @id
  lastSeenVisibility     VisibilityLevel     @default(EVERYONE)
  onlineStatusVisibility VisibilityLevel     @default(EVERYONE)
  readReceipts           Boolean             @default(true)
  profileVisibility      VisibilityLevel     @default(EVERYONE)
  pushNotifications      Boolean             @default(true)
  messageNotifications   Boolean             @default(true)
  mentionNotifications   Boolean             @default(true)
  groupNotifications     Boolean             @default(true)
  marketingNotifications Boolean             @default(false)
  emailNotifications     Boolean             @default(true)
  notificationSound      Boolean             @default(true)
  notificationVibration  Boolean             @default(true)
  accentColor            String              @default("oklch(0.55 0.2 145)")
  fontSize               FontSizeLevel       @default(MEDIUM)
  messageDensity         MessageDensityLevel @default(COMFORTABLE)
  chatWallpaper          String              @default("default")
  autoDownloadMedia      AutoDownloadMode    @default(WIFI)
  mediaQuality           MediaQualityLevel   @default(HIGH)
  saveDrafts             Boolean             @default(true)
  linkPreviews           Boolean             @default(true)
  typingIndicators       Boolean             @default(true)
  autoCleanupDays        Int                 @default(30)
  locationVisibility     LocationVisibility  @default(APPROXIMATE)
  discoveryVisibility    DiscoveryVisibility @default(EVERYONE)
  showOnlineStatus       Boolean             @default(true)
  updatedAt              DateTime            @updatedAt
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  pointsAwarded  Int      @default(50)
  createdAt      DateTime @default(now())
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred       User     @relation(fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerId, createdAt])
}

model Device {
  id         String   @id @default(uuid())
  userId     String
  pushToken  String?
  platform   String
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserLocation {
  userId    String   @id
  latitude  Float
  longitude Float
  geohash   String   @db.VarChar(12)
  cityId    String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      City?    @relation(fields: [cityId], references: [id])

  @@index([geohash])
  @@index([cityId, updatedAt])
}

model UserInterest {
  userId   String
  interest InterestSlug
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, interest])
}

model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  receiverId  String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?
  sender      User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status, createdAt])
  @@index([senderId, status])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model SuggestedConnection {
  id          String    @id @default(uuid())
  userId      String
  suggestedId String
  score       Float
  reason      String
  expiresAt   DateTime
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("SuggestedForUser", fields: [userId], references: [id], onDelete: Cascade)
  suggested   User      @relation("SuggestedTarget", fields: [suggestedId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestedId])
  @@index([userId, score])
}

model ConnectionStreak {
  userId         String    @id
  currentDays    Int       @default(0)
  longestDays    Int       @default(0)
  lastActiveDate DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyDiscovery {
  userId       String
  discoveredId String
  day          DateTime @db.Date
  discoverer   User     @relation("DailyDiscoverer", fields: [userId], references: [id], onDelete: Cascade)
  discovered   User     @relation("DailyDiscovered", fields: [discoveredId], references: [id], onDelete: Cascade)

  @@id([userId, discoveredId, day])
}

model Cafe {
  id              String   @id @default(uuid())
  name            String
  slug            String?  @unique
  description     String?
  logoUrl         String?
  coverUrl        String?
  phone           String?
  email           String?
  website         String?
  socialLinks     Json?
  openingHours    Json?
  wifiName        String?
  wifiPassword    String?
  createdById     String?
  address         String
  lat             Float
  lng             Float
  geohash         String?  @db.VarChar(12)
  cityId          String
  countryId       String
  avgRating       Float    @default(0)
  followerCount   Int      @default(0)
  reviewCount     Int      @default(0)
  isPartner       Boolean  @default(false)
  checkinCode     String?  @unique
  claimCode       String?  @unique
  bestCoffee      Boolean  @default(false)
  bestWorkspace   Boolean  @default(false)
  quiet           Boolean  @default(false)
  studyFriendly   Boolean  @default(false)
  fastWifi        Boolean  @default(false)
  outdoorSeating  Boolean  @default(false)
  dateFriendly    Boolean  @default(false)
  petFriendly     Boolean  @default(false)
  workspaceScore  Int      @default(0)
  liveWifiScore   Float?
  liveNoiseLevel  Float?
  liveOutletScore Float?
  workReportCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  city                City                     @relation(fields: [cityId], references: [id])
  country             Country                  @relation(fields: [countryId], references: [id])
  photos              CafePhoto[]
  posts               Post[]
  reviews             Review[]
  checkins            Checkin[]
  followers           CafeFollow[]
  favorites           FavoriteCafe[]
  voucherRedemptions  VoucherRedemption[]
  stamps              Stamp[]
  workReports         WorkReport[]
  staff               CafeStaff[]
  staffInvites        CafeStaffInvite[]
  auditLogs           AuditLog[]
  tables              CafeTable[]
  qrCodes             QrCode[]
  qrScans             QrScan[]
  customers           CafeCustomer[]
  loyaltyPrograms     LoyaltyProgram[]
  announcements       Announcement[]
  dailyStats          CafeDailyStat[]
  createdBy           User?                    @relation("CafeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events              CommunityEvent[]
  squads              Squad[]
  collectibleCard     CollectibleCard?
  activities          FriendActivity[]
  dailyDraws          CafeDailyDraw[]
  menu                CafeMenu?
  beans               Bean[]
  featureFlags        CafeFeatureFlag[]
  templateAssignments MenuTemplateAssignment[]

  @@index([cityId])
  @@index([cityId, avgRating])
  @@index([createdAt])
  @@index([followerCount])
  @@index([geohash])
}

model CafePhoto {
  id     String        @id @default(uuid())
  cafeId String
  url    String
  kind   CafePhotoKind @default(GALLERY)
  order  Int           @default(0)
  cafe   Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
}

model CafeMenu {
  id               String         @id @default(uuid())
  cafeId           String         @unique
  slug             String         @unique
  welcomeTitle     String?
  welcomeMessage   String?
  welcomeImageUrl  String?
  accentColor      String         @default("#2C1810")
  theme            MenuTheme      @default(MINIMAL)
  themeConfig      Json?
  isPublished      Boolean        @default(false)
  activeTemplateId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cafe             Cafe           @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  activeTemplate   MenuTemplate?  @relation("ActiveTemplate", fields: [activeTemplateId], references: [id], onDelete: SetNull)
  categories       MenuCategory[]

  @@index([slug])
}

model MenuCategory {
  id     String     @id @default(uuid())
  menuId String
  name   String
  order  Int        @default(0)
  menu   CafeMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items  MenuItem[]

  @@index([menuId, order])
}

model MenuItem {
  id            String       @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  price         Int
  discountPrice Int?
  calories      Int?
  ingredients   String[]     @default([])
  allergens     String[]     @default([])
  prepTimeMin   Int?
  imageUrl      String?
  images        String[]     @default([])
  videoUrl      String?
  order         Int          @default(0)
  isAvailable   Boolean      @default(true)
  viewCount     Int          @default(0)
  category      MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
}

model CafeFollow {
  id        String   @id @default(uuid())
  userId    String
  cafeId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([userId, cafeId])
}

model FavoriteCafe {
  id     String @id @default(uuid())
  userId String
  cafeId String
  cityId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe   Cafe   @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id])

  @@unique([userId, cafeId])
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  cafeId    String?
  checkinId String?  @unique
  type      PostType
  caption   String?
  cityId    String
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cafe      Cafe?          @relation(fields: [cafeId], references: [id])
  checkin   Checkin?       @relation(fields: [checkinId], references: [id])
  city      City           @relation(fields: [cityId], references: [id])
  country   Country        @relation(fields: [countryId], references: [id])
  photos    PostPhoto[]
  comments  Comment[]
  likes     Like[]
  reactions PostReaction[]
  savedBy   SavedPost[]

  @@index([authorId, createdAt])
  @@index([cafeId, createdAt])
  @@index([createdAt])
}

model PostPhoto {
  id     String @id @default(uuid())
  postId String
  url    String
  order  Int    @default(0)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  postId    String?
  reviewId  String?
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Like {
  id       String  @id @default(uuid())
  userId   String
  postId   String?
  reviewId String?
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, reviewId])
}

model SavedPost {
  id     String @id @default(uuid())
  userId String
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Review {
  id        String   @id @default(uuid())
  cafeId    String
  authorId  String
  rating    Int
  body      String?
  cityId    String
  countryId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cafe     Cafe          @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  city     City          @relation(fields: [cityId], references: [id])
  country  Country       @relation(fields: [countryId], references: [id])
  photos   ReviewPhoto[]
  comments Comment[]
  likes    Like[]

  @@index([cafeId, createdAt])
}

model ReviewPhoto {
  id       String @id @default(uuid())
  reviewId String
  url      String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Checkin {
  id          String        @id @default(uuid())
  userId      String
  cafeId      String
  cityId      String
  countryId   String
  source      CheckinSource @default(APP)
  mood        String?
  status      String?
  withUserIds String[]      @default([])
  createdAt   DateTime      @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe         Cafe                 @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  city         City                 @relation(fields: [cityId], references: [id])
  country      Country              @relation(fields: [countryId], references: [id])
  post         Post?
  stamp        Stamp?
  dailyDrawWin CafeDailyDrawWinner?

  @@index([userId, createdAt])
  @@index([cafeId, createdAt])
  @@index([userId, cafeId, createdAt])
}

model CafeDailyDraw {
  id          String   @id @default(uuid())
  cafeId      String
  day         DateTime @db.Date
  winnerCount Int      @default(0)
  maxWinners  Int      @default(10)
  createdAt   DateTime @default(now())

  cafe    Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  winners CafeDailyDrawWinner[]

  @@unique([cafeId, day])
  @@index([day])
}

model CafeDailyDrawWinner {
  id          String    @id @default(uuid())
  drawId      String
  userId      String
  checkinId   String    @unique
  voucherCode String    @unique
  notifiedAt  DateTime?
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())

  draw    CafeDailyDraw @relation(fields: [drawId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkin Checkin       @relation(fields: [checkinId], references: [id], onDelete: Cascade)

  @@unique([drawId, userId])
  @@index([userId])
  @@index([voucherCode])
}

model Passport {
  id            String   @id @default(uuid())
  userId        String   @unique
  totalStamps   Int      @default(0)
  totalCheckins Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stamps        Stamp[]
}

model Stamp {
  id         String   @id @default(uuid())
  passportId String
  cafeId     String
  checkinId  String?  @unique
  earnedAt   DateTime @default(now())
  passport   Passport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  cafe       Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  checkin    Checkin? @relation(fields: [checkinId], references: [id], onDelete: SetNull)

  @@unique([passportId, cafeId])
  @@index([passportId, earnedAt])
}

model BadgeDefinition {
  code          BadgeCode   @id
  name          String
  description   String
  iconKey       String
  threshold     Int
  thresholdType String
  userBadges    UserBadge[]
}

model UserBadge {
  id        String          @id @default(uuid())
  userId    String
  badgeCode BadgeCode
  earnedAt  DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     BadgeDefinition @relation(fields: [badgeCode], references: [code])

  @@unique([userId, badgeCode])
  @@index([userId, earnedAt])
}

model RewardDefinition {
  id             String       @id @default(uuid())
  slug           String       @unique
  title          String
  description    String
  requiredStamps Int
  rewardType     RewardType
  active         Boolean      @default(true)
  userRewards    UserReward[]
}

model UserReward {
  id         String           @id @default(uuid())
  userId     String
  rewardId   String
  unlockedAt DateTime         @default(now())
  redeemedAt DateTime?
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward     RewardDefinition @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId])
  @@index([userId, unlockedAt])
}

model Conversation {
  id        String               @id @default(uuid())
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  members   ConversationMember[]
  messages  Message[]
}

model ConversationMember {
  id                String       @id @default(uuid())
  conversationId    String
  userId            String
  lastReadAt        DateTime?
  lastReadMessageId String?
  muted             Boolean      @default(false)
  pinned            Boolean      @default(false)
  deletedAt         DateTime?
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id                    String            @id @default(uuid())
  conversationId        String
  senderId              String
  type                  MessageType       @default(TEXT)
  body                  String?
  imageUrl              String?
  attachmentUrl         String?
  attachmentName        String?
  attachmentMimeType    String?
  attachmentSize        Int?
  attachmentDurationSec Int?
  locationLat           Float?
  locationLng           Float?
  locationLabel         String?
  sticker               String?
  replyToId             String?
  replyToSnippet        String?
  forwardedFromId       String?
  forwardedFromName     String?
  editedAt              DateTime?
  deletedAt             DateTime?
  isPinned              Boolean           @default(false)
  spoiler               Boolean           @default(false)
  isSpoiler             Boolean           @default(false)
  viewOnce              Boolean           @default(false)
  viewOnceOpenedBy      String[]          @default([])
  thumbnailUrl          String?
  mediaWidth            Int?
  mediaHeight           Int?
  seenBy                String[]          @default([])
  createdAt             DateTime          @default(now())
  conversation          Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender                User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions             MessageReaction[]
  hides                 MessageHide[]

  @@index([conversationId, createdAt])
}

model MessageHide {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  hiddenAt  DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model BeanScoreProfile {
  userId           String    @id
  totalPoints      Int       @default(0)
  level            Int       @default(1)
  lastDailyBonusAt DateTime?
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
}

model BeanScoreEvent {
  id          String          @id @default(uuid())
  userId      String
  action      BeanScoreAction
  points      Int
  referenceId String?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action, referenceId])
  @@index([userId, createdAt])
}

model PostReaction {
  id        String        @id @default(uuid())
  userId    String
  postId    String
  emoji     ReactionEmoji @default(LIKE)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model WorkReport {
  id          String   @id @default(uuid())
  userId      String
  cafeId      String
  wifiScore   Int
  noiseLevel  Int
  outletScore Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe        Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@index([cafeId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  actorId    String?
  entityType String?
  entityId   String?
  payload    Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  deviceName String?
  browser    String?
  os         String?
  ipAddress  String?
  userAgent  String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GiftCoffee {
  id          String     @id @default(uuid())
  senderId    String
  receiverId  String?
  amount      Int
  cityId      String
  countryId   String
  status      GiftStatus @default(PENDING_PAYMENT)
  paymentRef  String?
  voucherCode String?    @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sender      User                @relation("GiftSender", fields: [senderId], references: [id])
  receiver    User?               @relation("GiftReceiver", fields: [receiverId], references: [id])
  city        City                @relation(fields: [cityId], references: [id])
  country     Country             @relation(fields: [countryId], references: [id])
  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id               String     @id @default(uuid())
  giftId           String
  cafeId           String
  redeemedByUserId String?
  redeemedAt       DateTime   @default(now())
  gift             GiftCoffee @relation(fields: [giftId], references: [id])
  cafe             Cafe       @relation(fields: [cafeId], references: [id])
  redeemedBy       User?      @relation(fields: [redeemedByUserId], references: [id])
}

model CafeStaff {
  id        String   @id @default(uuid())
  userId    String
  cafeId    String
  role      CafeRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([userId, cafeId])
  @@index([cafeId])
}

model CafeStaffInvite {
  id          String                @id @default(uuid())
  cafeId      String
  inviterId   String
  inviteeId   String
  role        CafeRole              @default(STAFF)
  status      CafeStaffInviteStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  respondedAt DateTime?
  cafe        Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  inviter     User                  @relation("StaffInviteInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee     User                  @relation("StaffInviteInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([cafeId, status])
}

model AuditLog {
  id        String   @id @default(uuid())
  cafeId    String
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cafeId, createdAt])
}

model CafeTable {
  id        String   @id @default(uuid())
  cafeId    String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  qrCode    QrCode?

  @@index([cafeId, order])
}

model QrCode {
  id        String     @id @default(uuid())
  cafeId    String
  kind      QrCodeKind @default(MENU)
  tableId   String?    @unique
  eventId   String?
  code      String     @unique
  label     String?
  scanCount Int        @default(0)
  createdAt DateTime   @default(now())
  cafe      Cafe       @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  table     CafeTable? @relation(fields: [tableId], references: [id], onDelete: Cascade)
  scans     QrScan[]

  @@index([cafeId, kind])
}

model QrScan {
  id        String   @id @default(uuid())
  cafeId    String
  qrCodeId  String?
  userId    String?
  scannedAt DateTime @default(now())
  cafe      Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  qrCode    QrCode?  @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([cafeId, scannedAt])
  @@index([qrCodeId, scannedAt])
}

model CafeCustomer {
  id           String   @id @default(uuid())
  cafeId       String
  userId       String
  firstVisitAt DateTime @default(now())
  lastVisitAt  DateTime @default(now())
  visitCount   Int      @default(0)
  scanCount    Int      @default(0)
  isVip        Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  cafe         Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cafeId, userId])
  @@index([cafeId, lastVisitAt])
  @@index([cafeId, visitCount])
}

model LoyaltyProgram {
  id          String                @id @default(uuid())
  cafeId      String
  kind        LoyaltyProgramKind    @default(STAMP_CARD)
  title       String
  description String?
  goal        Int                   @default(5)
  rewardLabel String
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  cafe        Cafe                  @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  progress    LoyaltyCardProgress[]

  @@index([cafeId, isActive])
}

model LoyaltyCardProgress {
  id          String         @id @default(uuid())
  programId   String
  userId      String
  progress    Int            @default(0)
  completedAt DateTime?
  redeemedAt  DateTime?
  updatedAt   DateTime       @updatedAt
  program     LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([programId, userId])
  @@index([userId])
}

model Announcement {
  id          String           @id @default(uuid())
  cafeId      String
  kind        AnnouncementKind @default(ANNOUNCEMENT)
  title       String
  body        String
  imageUrl    String?
  scheduledAt DateTime?
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cafe        Cafe             @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([cafeId, createdAt])
  @@index([publishedAt])
  @@index([scheduledAt, publishedAt])
}

// Future-ready (not yet implemented): Order, Payment, Reservation models
// will hang off Cafe + CafeTable + CafeCustomer when ordering ships.
model CafeDailyStat {
  id                 String   @id @default(uuid())
  cafeId             String
  date               DateTime @db.Date
  visitors           Int      @default(0)
  qrScans            Int      @default(0)
  newCustomers       Int      @default(0)
  returningCustomers Int      @default(0)
  newFollowers       Int      @default(0)
  cafe               Cafe     @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([cafeId, date])
  @@index([cafeId, date])
}

model CommunityChallenge {
  id           String                   @id @default(uuid())
  title        String
  description  String
  type         ChallengeType
  goal         Int
  rewardPoints Int                      @default(100)
  cityId       String?
  startsAt     DateTime
  endsAt       DateTime
  active       Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  city         City?                    @relation(fields: [cityId], references: [id])
  participants ChallengeParticipation[]

  @@index([active, endsAt])
  @@index([cityId, startsAt])
}

model ChallengeParticipation {
  id          String             @id @default(uuid())
  userId      String
  challengeId String
  progress    Int                @default(0)
  completedAt DateTime?
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge   CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([challengeId, progress])
}

model CommunityEvent {
  id            String           @id @default(uuid())
  title         String
  description   String
  type          EventType        @default(OTHER)
  cafeId        String?
  cityId        String?
  hostId        String?
  capacity      Int?
  locationLabel String?
  coverUrl      String?
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime         @default(now())
  cafe          Cafe?            @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  city          City?            @relation(fields: [cityId], references: [id])
  host          User?            @relation("EventHost", fields: [hostId], references: [id], onDelete: SetNull)
  rsvps         EventRsvp[]
  reminders     EventReminder[]
  activities    FriendActivity[]
  beans         Bean[]

  @@index([startsAt])
  @@index([cityId, startsAt])
  @@index([type, startsAt])
}

model EventRsvp {
  id        String          @id @default(uuid())
  userId    String
  eventId   String
  status    EventRsvpStatus @default(GOING)
  createdAt DateTime        @default(now())
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CommunityEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now())
  reporter   User             @relation(fields: [reporterId], references: [id])

  @@index([reporterId, createdAt])
  @@index([status, createdAt])
}

/// In-app bug / problem report captured from the client (shake-to-report).
/// Sensitive values inside `logs`, `metadata`, `deviceInfo` and `appInfo`
/// are PII-masked at the service layer before they reach this table.
model BugReport {
  id            String      @id @default(uuid())
  ticketNumber  String      @unique
  userId        String?
  title         String
  description   String
  category      BugCategory @default(BUG)
  severity      BugSeverity @default(MEDIUM)
  status        BugStatus   @default(OPEN)
  route         String?
  deviceInfo    Json?
  appInfo       Json?
  metadata      Json?
  logs          Json?
  screenshotUrl String?
  replayUrl     String?

  // AI triage output
  aiSummary       String?
  aiProbableCause String?
  aiSeverity      BugSeverity?
  aiReproSteps    Json?
  triagedAt       DateTime?

  // Duplicate grouping
  fingerprint   String?
  duplicateOfId String?

  // Support / admin workflow
  assigneeId String?
  fixVersion String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?                 @relation("BugReporter", fields: [userId], references: [id], onDelete: SetNull)
  assignee    User?                 @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  duplicateOf BugReport?            @relation("BugDuplicates", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  BugReport[]           @relation("BugDuplicates")
  comments    BugReportComment[]
  attachments BugReportAttachment[]

  @@index([status, createdAt])
  @@index([category, createdAt])
  @@index([severity, createdAt])
  @@index([assigneeId, status])
  @@index([fingerprint])
  @@index([userId, createdAt])
}

model BugReportComment {
  id        String   @id @default(uuid())
  reportId  String
  authorId  String?
  body      String
  /// Internal notes are visible to staff only; non-internal are shown to the reporter.
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  author User?     @relation("BugCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
}

model BugReportAttachment {
  id        String            @id @default(uuid())
  reportId  String
  kind      BugAttachmentKind @default(OTHER)
  url       String
  mimeType  String?
  sizeBytes Int?
  meta      Json?
  createdAt DateTime          @default(now())

  report BugReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model FriendActivity {
  id         String       @id @default(uuid())
  actorId    String
  type       ActivityType
  cafeId     String?
  eventId    String?
  squadId    String?
  badgeCode  BadgeCode?
  checkinId  String?
  cityId     String?
  cheerCount Int          @default(0)
  payload    Json?
  createdAt  DateTime     @default(now())

  actor User            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  cafe  Cafe?           @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  event CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  squad Squad?          @relation(fields: [squadId], references: [id], onDelete: SetNull)
  city  City?           @relation(fields: [cityId], references: [id])

  @@index([actorId, createdAt])
  @@index([type, createdAt])
  @@index([cityId, createdAt])
  @@index([createdAt])
}

model Squad {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String?
  category    SquadCategory @default(OTHER)
  cafeId      String?
  cityId      String?
  countryId   String?
  coverUrl    String?
  emoji       String?
  isPublic    Boolean       @default(true)
  memberCount Int           @default(0)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  cafe       Cafe?            @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  city       City?            @relation(fields: [cityId], references: [id])
  country    Country?         @relation(fields: [countryId], references: [id])
  createdBy  User?            @relation("SquadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members    SquadMember[]
  messages   SquadMessage[]
  activities FriendActivity[]
  beans      Bean[]

  @@index([cafeId])
  @@index([cityId, memberCount])
  @@index([category])
}

model SquadMember {
  id         String    @id @default(uuid())
  squadId    String
  userId     String
  role       SquadRole @default(MEMBER)
  points     Int       @default(0)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?
  squad      Squad     @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([squadId, userId])
  @@index([userId])
  @@index([squadId, points])
}

model SquadMessage {
  id        String   @id @default(uuid())
  squadId   String
  senderId  String
  body      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  squad     Squad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([squadId, createdAt])
}

model CollectibleCard {
  id          String            @id @default(uuid())
  cafeId      String            @unique
  name        String
  artworkUrl  String?
  rarity      CardRarity        @default(COMMON)
  description String?
  createdAt   DateTime          @default(now())
  cafe        Cafe              @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  collectedBy UserCollectible[]

  @@index([rarity])
}

model UserCollectible {
  id          String          @id @default(uuid())
  userId      String
  cardId      String
  checkinId   String?
  collectedAt DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        CollectibleCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, collectedAt])
}

model UserStreak {
  id          String     @id @default(uuid())
  userId      String
  type        StreakType
  current     Int        @default(0)
  best        Int        @default(0)
  lastEventOn DateTime?
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

model EventReminder {
  id        String         @id @default(uuid())
  userId    String
  eventId   String
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([remindAt, sentAt])
}

// ===== Beans — the social content layer =====

enum BeanType {
  QUICK
  PHOTO
  VIDEO
  LOCAL
  CAFE
  EVENT
  COMMUNITY
}

enum BeanMediaType {
  IMAGE
  VIDEO
  GIF
}

enum BeanReactionType {
  LOVE
  BREWED
  HOT
  NICE
  INSIGHTFUL
  FUNNY
}

model Bean {
  id            String   @id @default(uuid())
  authorId      String
  type          BeanType @default(QUICK)
  body          String?
  cafeId        String?
  eventId       String?
  squadId       String?
  cityId        String?
  countryId     String?
  locationLabel String?
  lat           Float?
  lng           Float?
  linkUrl       String?
  // Conversations: parent = direct reply target, root = top of the chain
  parentId      String?
  rootId        String?
  quotedBeanId  String?
  rebeanOfId    String?
  replyCount    Int      @default(0)
  rebeanCount   Int      @default(0)
  quoteCount    Int      @default(0)
  reactionCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author     User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cafe       Cafe?           @relation(fields: [cafeId], references: [id], onDelete: SetNull)
  event      CommunityEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  squad      Squad?          @relation(fields: [squadId], references: [id], onDelete: SetNull)
  city       City?           @relation(fields: [cityId], references: [id])
  country    Country?        @relation(fields: [countryId], references: [id])
  parent     Bean?           @relation("BeanReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Bean[]          @relation("BeanReplies")
  quotedBean Bean?           @relation("BeanQuotes", fields: [quotedBeanId], references: [id], onDelete: SetNull)
  quotes     Bean[]          @relation("BeanQuotes")
  rebeanOf   Bean?           @relation("ReBeans", fields: [rebeanOfId], references: [id], onDelete: Cascade)
  rebeans    Bean[]          @relation("ReBeans")
  media      BeanMedia[]
  poll       BeanPoll?
  reactions  BeanReaction[]
  hashtags   BeanHashtag[]
  mentions   BeanMention[]

  @@unique([authorId, rebeanOfId])
  @@index([authorId, createdAt])
  @@index([cafeId, createdAt])
  @@index([squadId, createdAt])
  @@index([eventId, createdAt])
  @@index([cityId, createdAt])
  @@index([parentId, createdAt])
  @@index([rootId, createdAt])
  @@index([createdAt])
}

model BeanMedia {
  id     String        @id @default(uuid())
  beanId String
  type   BeanMediaType @default(IMAGE)
  url    String
  order  Int           @default(0)
  bean   Bean          @relation(fields: [beanId], references: [id], onDelete: Cascade)

  @@index([beanId])
}

model BeanPoll {
  id      String           @id @default(uuid())
  beanId  String           @unique
  endsAt  DateTime?
  bean    Bean             @relation(fields: [beanId], references: [id], onDelete: Cascade)
  options BeanPollOption[]
  votes   BeanPollVote[]
}

model BeanPollOption {
  id        String         @id @default(uuid())
  pollId    String
  label     String
  order     Int            @default(0)
  voteCount Int            @default(0)
  poll      BeanPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes     BeanPollVote[]

  @@index([pollId])
}

model BeanPollVote {
  id        String         @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime       @default(now())
  poll      BeanPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    BeanPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

model BeanReaction {
  id        String           @id @default(uuid())
  beanId    String
  userId    String
  type      BeanReactionType
  createdAt DateTime         @default(now())
  bean      Bean             @relation(fields: [beanId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([beanId, userId])
  @@index([beanId])
  @@index([createdAt])
}

model Hashtag {
  id        String        @id @default(uuid())
  tag       String        @unique
  beanCount Int           @default(0)
  createdAt DateTime      @default(now())
  beans     BeanHashtag[]

  @@index([beanCount])
}

model BeanHashtag {
  beanId    String
  hashtagId String
  bean      Bean    @relation(fields: [beanId], references: [id], onDelete: Cascade)
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([beanId, hashtagId])
  @@index([hashtagId])
}

model BeanMention {
  id     String @id @default(uuid())
  beanId String
  userId String
  bean   Bean   @relation(fields: [beanId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([beanId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Super-admin: feature flags, menu templates, audit log
// ---------------------------------------------------------------------------

/// Platform-wide feature toggle. `key` is a stable identifier from the
/// feature-flag registry (src/feature-flags/feature-flags.constants.ts).
model FeatureFlag {
  key           String   @id
  label         String
  description   String?
  category      String   @default("general")
  enabledGlobal Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  cafeOverrides CafeFeatureFlag[]
}

/// Per-cafe override of a feature flag. When present, `enabled` wins over the
/// flag's global default for that cafe.
model CafeFeatureFlag {
  id        String   @id @default(uuid())
  cafeId    String
  flagKey   String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  cafe Cafe        @relation(fields: [cafeId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([cafeId, flagKey])
  @@index([flagKey])
}

/// A reusable menu the super admin builds once and can clone onto any cafe.
model MenuTemplate {
  id              String                   @id @default(uuid())
  name            String
  description     String?
  previewImageUrl String?
  welcomeTitle    String?
  welcomeMessage  String?
  accentColor     String                   @default("#2C1810")
  theme           MenuTheme                @default(MINIMAL)
  themeConfig     Json?
  /// Origin of the template: "custom" for ones built in the admin panel,
  /// "file" for ones imported from a file dropped in the project directory.
  source          String                   @default("custom")
  /// Stable key of the source file (its filename without extension) when
  /// imported from disk. Lets re-imports update in place instead of duplicating.
  sourceKey       String?                  @unique
  createdById     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  categories      MenuTemplateCategory[]
  assignments     MenuTemplateAssignment[]
  activeOnMenus   CafeMenu[]               @relation("ActiveTemplate")
}

/// Grants a cafe access to a template (WordPress-style "available theme").
/// A cafe can be assigned many templates; one may be set active on its menu.
model MenuTemplateAssignment {
  id           String       @id @default(uuid())
  templateId   String
  cafeId       String
  assignedById String?
  createdAt    DateTime     @default(now())
  template     MenuTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  cafe         Cafe         @relation(fields: [cafeId], references: [id], onDelete: Cascade)

  @@unique([templateId, cafeId])
  @@index([cafeId])
}

model MenuTemplateCategory {
  id         String             @id @default(uuid())
  templateId String
  name       String
  order      Int                @default(0)
  template   MenuTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items      MenuTemplateItem[]

  @@index([templateId, order])
}

model MenuTemplateItem {
  id            String               @id @default(uuid())
  categoryId    String
  name          String
  description   String?
  price         Int
  discountPrice Int?
  calories      Int?
  ingredients   String[]             @default([])
  allergens     String[]             @default([])
  prepTimeMin   Int?
  imageUrl      String?
  images        String[]             @default([])
  videoUrl      String?
  order         Int                  @default(0)
  isAvailable   Boolean              @default(true)
  category      MenuTemplateCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, order])
}

/// Platform-wide audit trail of super-admin actions (the existing AuditLog is
/// cafe-scoped and requires a cafeId, so it can't capture platform actions).
model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

/// Per-user state of the multi-step activation onboarding. 1:1 with User.
/// `completedSteps`/`skippedSteps` hold step keys (welcome, interests, avatar,
/// circle, firstPost, cafe, achievement, profile, invite). `stepTimings` maps
/// a step key to milliseconds spent, for the funnel/time-spent analytics.
model OnboardingProgress {
  userId         String    @id
  currentStep    String    @default("welcome")
  completedSteps String[]  @default([])
  skippedSteps   String[]  @default([])
  stepTimings    Json      @default("{}")
  startedAt      DateTime  @default(now())
  lastActiveAt   DateTime  @default(now())
  completedAt    DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Customizable "bean" avatar. Stores discrete option keys; the client renders
/// the layered SVG. 1:1 with User.
model BeanAvatar {
  userId    String   @id
  bg        String   @default("crema")
  skin      String   @default("roast")
  hair      String   @default("none")
  glasses   String   @default("none")
  beard     String   @default("none")
  outfit    String   @default("apron")
  accessory String   @default("none")
  coffeeCup String   @default("latte")
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only funnel events for the onboarding flow (step viewed/skipped/
/// completed + time spent). Powers conversion + drop-off metrics.
model OnboardingEvent {
  id          String   @id @default(uuid())
  userId      String
  step        String
  type        String
  timeSpentMs Int?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, step])
  @@index([step, type])
  @@index([createdAt])
}

/// Admin-configurable definition of a single onboarding activation step.
/// Synced from ONBOARDING_FLOW_STEPS on boot; `enabled`/`order` are editable
/// from the super-admin panel and drive the live onboarding sequence.
model OnboardingStepConfig {
  key         String   @id
  label       String
  description String?
  enabled     Boolean  @default(true)
  order       Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([order])
}

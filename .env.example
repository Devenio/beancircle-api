DATABASE_URL="postgresql://beancircle:CHANGE_ME@127.0.0.1:5434/beancircle?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/api/v1/auth/google/callback"
SMS_PROVIDER="mock"
# SMS.ir — set SMS_PROVIDER to anything other than "mock" to activate real sending
SMSIR_API_KEY=""
SMSIR_LINE_NUMBER=""
# OTP template ID from your SMS.ir panel (Panel > Templates). Use 123456 for sandbox.
SMSIR_OTP_TEMPLATE_ID="123456"
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET="beancircle"
R2_PUBLIC_URL="http://localhost:9000/beancircle"
PAYMENT_PROVIDER="mock"
GIFT_WEBHOOK_SECRET=""
NODE_ENV="development"
# Web Push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
VAPID_SUBJECT="mailto:hello@beancircle.app"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# AI bug triage (optional). Leave empty to use the heuristic fallback.
ANTHROPIC_API_KEY=""
BUG_TRIAGE_MODEL="claude-haiku-4-5"
